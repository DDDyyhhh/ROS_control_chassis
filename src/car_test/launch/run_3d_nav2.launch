<launch>   
    <!-- =================================================================== -->
    <!-- ==================== 1. 启动底层与SLAM (保留你的配置) ============== -->
    <!-- =================================================================== -->
    
    <!-- 启动与 STM32 的通信 -->
    <node pkg="rosserial_python" type="serial_node.py" name="serial_node" output="screen">
        <param name="port" value="/dev/ttyUSB0"/>
        <param name="baud" value="115200"/>
    </node>
    
    <!-- 加载机器人 URDF (确保它会启动 robot_state_publisher) -->
    <include file="$(find mycar_description)/launch/car.launch" />
    
    <!-- 启动雷达驱动 -->
    <include file="$(find unitree_lidar_ros)/launch/run_without_rviz.launch"/>
    
    <!-- 启动 Point-LIO SLAM -->
    <node pkg="point_lio_unilidar" type="pointlio_mapping_STM32" name="laserMapping_STM32" output="screen">
        <rosparam command="load" file="$(find point_lio_unilidar)/config/unilidar_l2_STM32.yaml" />
    </node>

    <!-- =================================================================== -->
    <!-- ==================== 2. 启动Fast-Planner核心 ====================== -->
    <!-- =================================================================== -->

    <!-- 为地面小车适配的通用参数 -->
    <arg name="odom_topic" value="/pointlio/odom" />
    <arg name="cloud_topic" value="/pointlio/cloud_registered_body" />
    <arg name="map_size_x" value="40.0"/>
    <arg name="map_size_y" value="20.0"/>
    <arg name="map_size_z" value="2.0"/>  <!-- 【关键】Z轴高度减小，节省资源并专注于地面 -->
    <arg name="max_vel" value="1.0" />    <!-- 【关键】你的小车最大速度 (m/s) -->
    <arg name="max_acc" value="0.5" />    <!-- 【关键】你的小车最大加速度 (m/s^2) -->

    <!-- 【核心节点】 包含了感知和规划 -->
    <node pkg="plan_manage" name="fast_planner_node" type="fast_planner_node" output="screen">
        
        <!-- (A) 数据流重映射 -->
        <remap from="/odom_world" to="$(arg odom_topic)"/>
        <remap from="/sdf_map/odom" to="$(arg odom_topic)"/>
        <remap from="/sdf_map/cloud" to="$(arg cloud_topic)"/>
        
        <!-- (B) 参数配置 (直接在此处定义，不再使用旧的YAML，方便调试) -->
        <param name="planner_node/planner" value="1" type="int"/>

        <!-- FSM & 目标点设置 -->
        <param name="fsm/flight_type" value="1" type="int"/>
        <param name="fsm/thresh_replan" value="1.5" type="double"/>
        <param name="fsm/thresh_no_replan" value="2.0" type="double"/>

        <!-- 地图参数适配 (非常重要!) -->
        <param name="sdf_map/resolution"      value="0.1" /> 
        <param name="sdf_map/map_size_x"   value="$(arg map_size_x)" /> 
        <param name="sdf_map/map_size_y"   value="$(arg map_size_y)" /> 
        <param name="sdf_map/map_size_z"   value="$(arg map_size_z)" /> 
        <param name="sdf_map/local_update_range_x"  value="5.5" /> 
        <param name="sdf_map/local_update_range_y"  value="5.5" /> 
        <param name="sdf_map/local_update_range_z"  value="2.0" />
        <param name="sdf_map/obstacles_inflation"     value="0.25" /> <!-- 【关键】障碍物膨胀半径，应略大于车体半径 -->
        <param name="sdf_map/ground_height"        value="0.0"/>    <!-- 【关键】将地面高度设置为0 -->
        <param name="sdf_map/esdf_slice_height" value="0.5"/>      <!-- 【关键】设置规划所用的地图切片高度 -->
        <param name="sdf_map/use_depth_filter" value="false"/>    <!-- 使用激光雷达，禁用深度相机滤波器 -->
        <param name="sdf_map/pose_type"     value="2"/>
        <param name="sdf_map/frame_id"      value="map"/>

        <!-- 规划器管理参数 -->
        <param name="manager/max_vel" value="$(arg max_vel)" type="double"/>
        <param name="manager/max_acc" value="$(arg max_acc)" type="double"/>
        <param name="manager/max_jerk" value="2.0" type="double"/>
        <param name="manager/clearance_threshold" value="0.2" type="double"/>
        <param name="manager/use_kinodynamic_path" value="true" type="bool"/>
        <param name="manager/use_optimization" value="true" type="bool"/>

        <!-- 搜索和优化参数 -->
        <param name="search/margin" value="0.25" type="double"/> <!-- 安全边际，最好和膨胀半径一致 -->
        <param name="bspline/limit_vel" value="$(arg max_vel)" type="double"/>
        <param name="bspline/limit_acc" value="$(arg max_acc)" type="double"/>
    </node>

    <!-- =================================================================== -->
    <!-- ==================== 3. 启动辅助模块 ============================== -->
    <!-- =================================================================== -->
    
    <!-- 轨迹服务器 (使用标准、清晰的话题名) -->
    <node pkg="plan_manage" name="traj_server" type="traj_server" output="screen">
        <remap from="/position_cmd" to="/planning/pos_cmd"/>
        <remap from="/odom_world" to="$(arg odom_topic)"/>
    </node>
    
    <!-- 目标点生成器 -->
    <node pkg="waypoint_generator" name="waypoint_generator" type="waypoint_generator" output="screen">
        <remap from="~odom" to="$(arg odom_topic)"/>        
        <remap from="~goal" to="/move_base_simple/goal"/>
        <remap from="~traj_start_trigger" to="/traj_start_trigger" />
        <param name="waypoint_type" value="manual-lonely-waypoint"/>
    </node>

    <!-- =================================================================== -->
    <!-- ==================== 4. 启动【正确】的控制器 ======================= -->
    <!-- =================================================================== -->
    
    <!-- 【【【【【 这是整个修改中最重要的一步 】】】】】 -->
    <!-- 移除无人机用的 so3_control_nodelet -->
    <!-- 替换为我们为地面车辆编写的 python 控制器 -->
    <node pkg="car_test"
          type="planner_to_cmdvel.py" 
          name="planner_controller" 
          output="screen"><!-- 【需修改】替换成你的脚本名 --> <!-- 【需修改】替换成你的包名 -->
        <!-- 这个控制器内部会订阅 /planning/pos_cmd 和 /pointlio/odom -->
        <!-- 并发布到 /cmd_vel -->
        <param name="max_linear_vel" value="0.8" /> <!-- 可以通过参数服务器设置控制器的最大速度 -->
        <param name="max_angular_vel" value="0.6" />
    </node>


    <!-- =================================================================== -->
    <!-- ==================== 5. 可视化 ==================================== -->
    <!-- =================================================================== -->
    
    <!-- 启动Rviz进行调试, 建议使用一个保存好的配置文件 -->
    <!-- <node pkg="rviz" type="rviz" name="rviz" args="-d $(find your_package_name)/rviz/nav_debug.rviz" /> -->

</launch>